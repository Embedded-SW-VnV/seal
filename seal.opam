opam-version: "2.0"
name: "seal"
version: "0.1"
synopsis: "Seal library - System Analysis Library"
maintainer: "pierre-loic.garoche@enac.fr"
authors: "Pierre-Loic Garoche"
license: "LGPL"
depends: [
  "dune" {>= "3.0"}
  "osdp"
]
build: [
  ["dune" "subst"] {pinned}
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
  ["dune" "build" "-p" name "@doc"] {with-doc}
]

